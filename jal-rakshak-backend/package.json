{
  "name": "jal-rakshak-backend",
  "version": "1.0.0",
  "description": "Production-ready backend API for Jal Rakshak - AI-powered flood intelligence and emergency response system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "npm run seed:all",
    "seed:citizen": "node src/scripts/seedCitizen.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:rescue": "node src/scripts/seedRescue.js",
    "seed:shelters": "node src/scripts/seedShelters.js",
    "seed:all": "node src/scripts/seedCitizen.js && node src/scripts/seedAdmin.js && node src/scripts/seedRescue.js && node src/scripts/seedShelters.js",
    "test:db": "node src/scripts/testDb.js",
    "clear:db": "node src/scripts/clearDatabase.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.2",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.9.13",
    "redis": "^4.6.13",
    "socket.io": "^4.8.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.8",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000,
    "verbose": true
  },
  "keywords": [
    "flood-intelligence",
    "disaster-management",
    "express",
    "mongodb",
    "fastapi",
    "jal-rakshak"
  ],
  "author": "Jal Rakshak Team",
  "license": "MIT"
}
